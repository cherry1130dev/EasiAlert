# Keystore signing configuration template
# Copy this file to 'keystore.properties' and fill in your actual keystore details.
# DO NOT commit keystore.properties to git.
RELEASE_STORE_FILE=easisafity-release.keystore
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
